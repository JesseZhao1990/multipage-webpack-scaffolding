{
  "name": "multipage-webpack-scaffolding",
  "version": "2.0.0",
  "private": true,
  "description": "A convention-driven Webpack 5 scaffold for multi-page websites",
  "scripts": {
    "build": "webpack --config build/webpack.prod.js",
    "dev": "webpack serve --config build/webpack.dev.js",
    "lint": "eslint .",
    "test": "node --test test/**/*.test.js",
    "check": "eslint . && node --test test/**/*.test.js && webpack --config build/webpack.prod.js"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JesseZhao1990/multipage-webpack-scaffolding.git"
  },
  "author": "Jesse Zhao",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "core-js": "^3.41.0",
    "lodash": "^4.17.21",
    "normalize.css": "^8.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/eslint-parser": "^7.27.0",
    "@babel/preset-env": "^7.26.9",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "ejs-loader": "^0.5.0",
    "eslint": "^9.22.0",
    "eslint-webpack-plugin": "^5.0.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "less": "^4.2.2",
    "less-loader": "^12.2.0",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
